{
  "Minditful": {
    "Environment": "",

    "WorkDay": {
      "Mode": "Flexible",
      "FlexEarliestStart": "08:00",
      "FlexLatestStart": "10:00",
      "FlexHours": 9,
      "Start": "09:00",
      "End": "18:00",
      "AwayAfterMinutes": 5,
      "TypingIdleSeconds": 3,
      "TypingSustainSeconds": 20,
      "FragmentationPerHour": 30,
      "AvgInProgressBaseline": 2.8,
      "RefreshMinutes": 5,
      "PresencePollSeconds": 30
    },

    "Storage": {
      "RetentionPeriod": "Week",
      "KeepPreviousPeriod": true,
      "MoodSampleMinutes": 15
    },

    "Wellbeing": {
      "FocusPlan": true,
      "FocusPlanMinMinutes": 60,
      "WeekReport": true,
      "MicroBreakEveryMinutes": 50,
      "MicroBreakMaxPerDay": 6,
      "EveningCheck": true,
      "HideWhenPresenting": true,
      "Wardrobe": true
    },

    "Llm": {
      "Enabled": true,
      "UseInDemo": false,
      "Model": "claude-opus-5",
      "Effort": "low",
      "TimeoutMs": 2500,
      "ApiKeyEnvVar": "ANTHROPIC_API_KEY",
      "RefusalFallback": true,
      "InsightTimeoutMs": 20000,
      "Features": {
        "Lines": true,
        "Chat": true,
        "Mood": "Rules",
        "Meetings": "Rules",
        "MoodIntervalMinutes": 30,
        "IncludeChatInMood": false
      }
    },

    "Production": {
      "PresenceMode": "Graph",
      "ContentProtection": true,
      "RequireOnlineMeeting": true,
      "MailMinWaitDays": 1,
      "ShowControlCenter": false,
      "Graph": {
        "Enabled": true,
        "ClientId": "55b3153f-ddfd-4120-9408-2f9e874fe660",
        "TenantId": "0ae51e19-07c8-4e0e-bb9d-648ee58410f4",
        "RedirectUri": "http://localhost",
        "UseBroker": false,
        "Scopes": [ "User.Read", "Presence.Read", "Calendars.Read" ]
      },
      "AzureDevOps": {
        "Enabled": true,
        "Organization": "<organization Bosch>",
        "Project": "<project>",
        "Team": "",
        "Auth": "Pat",
        "PatEnvVar": "MINDITFUL_PROD_ADO_PAT"
      }
    },

    "Sandbox": {
      "PresenceMode": "Graph",
      "ContentProtection": true,
      "RequireOnlineMeeting": true,
      "MailMinWaitDays": 1,
      "IncludeSelfSentMail": false,
      "ShowControlCenter": true,
      "AvgInProgressFallback": 2.5,
      "Polling": {
        "PresenceSeconds": 30,
        "CalendarSeconds": 120,
        "MailSeconds": 300,
        "BoardsSeconds": 180
      },
      "Graph": {
        "Enabled": true,
        "ClientId": "aa4ae2a6-4d2a-474c-a6f5-d7d2ebf5de06",
        "TenantId": "093be8d4-f285-4982-a198-db10d74e61e2",
        "RedirectUri": "http://localhost",
        "UseBroker": false,
        "Scopes": [ "User.Read", "Presence.Read", "Presence.ReadWrite", "Calendars.Read", "Calendars.ReadWrite", "Mail.Read" ]
      },
      "AzureDevOps": {
        "Enabled": true,
        "Organization": "mindiful-sandbox",
        "Project": "Milo-Sandbox",
        "Team": "Milo-Sandbox Team",
        "Auth": "Pat",
        "PatEnvVar": "MINDITFUL_SANDBOX_ADO_PAT",
        "ActiveStates": [ "Active" ],
        "DoneStates": [ "Closed", "Resolved" ],
        "SeedState": "Active"
      },
      "BehaviorOverrides": {
        "StuckTaskMinBusinessDays": 0,
        "EmailMinBusinessDaysWaiting": 0,
        "EmailNotBefore": "00:00",
        "NoBreakStreakMin": 20,
        "OverloadMinChainCount": 3,
        "BudgetGapMin": 3,
        "VisitEveryMin": [ 3, 5 ],
        "ParkedReminderTtlMin": 5
      }
    }
  }
}
