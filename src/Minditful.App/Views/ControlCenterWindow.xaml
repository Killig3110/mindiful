<Window x:Class="Minditful.App.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Minditful.App.Controls"
        Title="Minditful · Bảng điều khiển" Width="980" Height="780" MinWidth="820" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Sans}" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
            <ScrollViewer Style="{StaticResource ThinScroll}">
                <StackPanel>
                    <TextBlock x:Name="EnvEyebrow" Style="{StaticResource Eyebrow}" Text="MINDITFUL" />
                    <TextBlock x:Name="EnvTitle" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Cream}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="EnvHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock x:Name="Clock" FontFamily="{StaticResource Serif}" FontSize="40" Foreground="{StaticResource Amber}" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DayLabel" Foreground="{StaticResource Soft}" FontSize="12" />
                            <TextBlock x:Name="ClockState" Foreground="{StaticResource Soft}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ============ kết nối ============ -->
                    <TextBlock Style="{StaticResource Eyebrow}" Text="MICROSOFT 365 · TEAMS · OUTLOOK" Margin="0,18,0,6" />
                    <TextBlock x:Name="GraphStatus" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource Primary}" Content="Đăng nhập Microsoft" Margin="0,0,6,6" Click="SignIn_Click" />
                        <Button Style="{StaticResource Round}" Content="Đăng xuất" Margin="0,0,6,6" Click="SignOut_Click" />
                        <Button Style="{StaticResource Round}" Content="Làm mới dữ liệu" Margin="0,0,6,6" Click="Refresh_Click" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="AZURE BOARDS" Margin="0,14,0,6" />
                    <TextBlock x:Name="BoardsStatus" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PatBox" Height="32" Padding="10,6" Background="{StaticResource Panel2}" Foreground="{StaticResource Cream}"
                                     BorderBrush="{StaticResource Line}" ToolTip="Personal Access Token (Work Items: Read &amp; Write). Lưu mã hoá DPAPI trên máy này." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Round}" Content="Lưu PAT" Margin="6,0,0,0" Click="SavePat_Click" />
                            <Button Style="{StaticResource Round}" Content="Xoá PAT" Margin="6,0,0,0" Click="ClearPat_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="PatHint" Style="{StaticResource Hint}" Margin="0,4,0,0" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="DỮ LIỆU MILO ĐANG THẤY" Margin="0,14,0,6" />
                    <TextBlock x:Name="SnapSummary" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />

                    <!-- ============ lớp 2 · cá nhân hoá · góc neo ============ -->
                    <TextBlock Style="{StaticResource Eyebrow}" Text="CLAUDE · LỚP 2 LỜI THOẠI (§14)" Margin="0,14,0,6" />
                    <TextBlock x:Name="LlmStatus" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ClaudeKeyBox" Height="32" Padding="10,6" Background="{StaticResource Panel2}" Foreground="{StaticResource Cream}"
                                     BorderBrush="{StaticResource Line}" ToolTip="API key Claude. Lưu mã hoá DPAPI trên máy này. Claude chỉ nhận tên case + số liệu, không bao giờ nhận tiêu đề email/họp/task." />
                        <Button Grid.Column="1" Style="{StaticResource Round}" Content="Lưu key" Margin="6,0,0,0" Click="SaveClaudeKey_Click" />
                    </Grid>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="CÁ NHÂN HOÁ 7 NGÀY (§14)" Margin="0,14,0,6" />
                    <TextBlock x:Name="TuningText" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="DỮ LIỆU CÁ NHÂN TRÊN MÁY (SQLITE)" Margin="0,14,0,6" />
                    <TextBlock x:Name="StorageText" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />
                    <Button Style="{StaticResource Round}" Content="Xoá toàn bộ dữ liệu thống kê ngay" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Wipe_Click" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="CHĂM SÓC MỞ RỘNG (MỤC WELLBEING)" Margin="0,14,0,6" />
                    <TextBlock x:Name="WellbeingText" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="TỦ ĐỒ CỦA MILO · VỀ ĐÚNG GIỜ ĐỂ MỞ KHOÁ" Margin="0,14,0,6" />
                    <TextBlock x:Name="WardrobeText" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />
                    <UniformGrid x:Name="Wardrobe" Columns="5" Margin="0,8,0,0">
                        <Button Style="{StaticResource Round}" Tag="auto" Content="Tự chọn" Margin="0,0,6,6" Click="Accessory_Click" />
                        <Button Style="{StaticResource Round}" Tag="none" Content="Không mặc" Margin="0,0,6,6" Click="Accessory_Click" />
                        <Button Style="{StaticResource Round}" Tag="scarf" Content="Khăn quàng" Margin="0,0,6,6" Click="Accessory_Click" />
                        <Button Style="{StaticResource Round}" Tag="flower" Content="Kẹp hoa" Margin="0,0,6,6" Click="Accessory_Click" />
                        <Button Style="{StaticResource Round}" Tag="beret" Content="Mũ nồi" Margin="0,0,6,6" Click="Accessory_Click" />
                    </UniformGrid>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="GÓC NEO CỦA MILO (§9.1 · CŨNG CÓ THỂ KÉO CHÓP ĐUÔI)" Margin="0,14,0,6" />
                    <UniformGrid Columns="4">
                        <Button Style="{StaticResource Round}" Tag="TopLeft" Content="↖ Trên trái" Margin="0,0,6,6" Click="Corner_Click" />
                        <Button Style="{StaticResource Round}" Tag="TopRight" Content="↗ Trên phải" Margin="0,0,6,6" Click="Corner_Click" />
                        <Button Style="{StaticResource Round}" Tag="BottomLeft" Content="↙ Dưới trái" Margin="0,0,6,6" Click="Corner_Click" />
                        <Button Style="{StaticResource Round}" Tag="BottomRight" Content="↘ Dưới phải" Margin="0,0,6,6" Click="Corner_Click" />
                    </UniformGrid>

                    <!-- ============ công cụ sandbox ============ -->
                    <StackPanel x:Name="SandboxTools">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="SANDBOX · TEST NHANH" Margin="0,18,0,6" />
                        <TextBlock x:Name="OverridesText" Style="{StaticResource Hint}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Primary}" Content="Reset ngày (chào sáng lại)" Margin="0,0,6,6" Click="ResetDay_Click" />
                            <TextBox x:Name="WorkEndBox" Width="64" Height="32" Margin="0,0,6,6" VerticalContentAlignment="Center" Padding="8,0"
                                     Background="{StaticResource Panel2}" Foreground="{StaticResource Cream}" BorderBrush="{StaticResource Line}"
                                     ToolTip="Giờ kết thúc khung làm việc (HH:mm)" />
                            <Button Style="{StaticResource Round}" Content="Đặt giờ về" Margin="0,0,6,6" Click="WorkEnd_Click" />
                            <Button Style="{StaticResource Round}" Content="Giờ về = bây giờ + 2'" Margin="0,0,6,6" Click="WorkEndSoon_Click" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Eyebrow}" Text="SANDBOX · DỮ LIỆU MẪU" Margin="0,18,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Text="Tự tạo dữ liệu thay cho đồng nghiệp (xem checklist ở docs/KET-NOI-SANDBOX.md mục 7): 1 Teams meeting sau 7 phút, chuỗi 3 cuộc họp liền, 6 work item giao cho bạn. Email mẫu nên do đồng nghiệp gửi (app không cần Mail.Send)." />
                        <Button x:Name="SeedBtn" Style="{StaticResource Primary}" Content="Tạo dữ liệu mẫu" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Seed_Click" />
                        <TextBlock x:Name="SeedLog" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource Eyebrow}" Text="SANDBOX · GIẢ LẬP TÍN HIỆU (ĐÈ LÊN TÍN HIỆU THẬT)" Margin="0,18,0,6" />
                        <UniformGrid x:Name="Acts" Columns="3">
                            <Button Style="{StaticResource Round}" Tag="typing" Content="Đang gõ phím" Margin="0,0,6,6" Click="Act_Click" />
                            <Button Style="{StaticResource Round}" Tag="away" Content="Rời khỏi máy" Margin="0,0,6,6" Click="Act_Click" />
                            <Button Style="{StaticResource Round}" Tag="fullscreen" Content="Toàn màn hình" Margin="0,0,6,6" Click="Act_Click" />
                            <Button Style="{StaticResource Round}" Tag="dnd" Content="Không làm phiền" Margin="0,0,6,6" Click="Act_Click" />
                            <Button Style="{StaticResource Round}" Tag="presenting" Content="Đang trình chiếu" Margin="0,0,6,6" Click="Act_Click" />
                            <Button Style="{StaticResource Round}" Tag="leave" Content="Rời cuộc họp" Margin="0,0,6,6" Click="Act_Click" />
                            <Button Style="{StaticResource Round}" Tag="frag" Content="Nhảy việc 12 lần" Margin="0,0,6,6" Click="Act_Click" />
                            <Button Style="{StaticResource Round}" Tag="stress" Content="Ngày căng −30" Margin="0,0,6,6" Click="Act_Click" />
                            <Button Style="{StaticResource Round}" Tag="dash" Content="Mở dashboard" Margin="0,0,6,6" Click="Act_Click" />
                        </UniformGrid>

                        <TextBlock Style="{StaticResource Eyebrow}" Text="SANDBOX · CHẠY THỬ 1 CASE NGAY (BỎ QUA ĐIỀU KIỆN &amp; NGÂN SÁCH)" Margin="0,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CaseBox" Height="32" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Round}" Content="Chạy" Margin="6,0,0,0" Click="Force_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Bấm nút trên thẻ của Milo để thử hành động thật: Giữ chỗ → tạo sự kiện trong Outlook, Khoá 90 phút → chặn lịch, Mở Outlook → mở email." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <c:BrainPanel x:Name="Brain" Grid.Column="1" />
    </Grid>
</Window>
