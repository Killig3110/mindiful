<Window x:Class="Minditful.App.Views.DemoControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Minditful.App.Controls"
        Title="Minditful · Demo — điều khiển kịch bản" Width="780" Height="840" MinWidth="680" MinHeight="520"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Sans}" FontSize="13"
        WindowStartupLocation="Manual">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
            <ScrollViewer Style="{StaticResource ThinScroll}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="MINDITFUL · MÔI TRƯỜNG DEMO" />
                    <TextBlock Text="Milo đang sống trên desktop của bạn theo kịch bản ngày mẫu" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Cream}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Đây là app thật như Sandbox/Production: nhìn góc màn hình để thấy Milo. Khác mỗi chỗ thời gian, lịch, email, task và thao tác của người dùng lấy từ kịch bản Thứ Năm 24/9 thay vì máy và tài khoản thật." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock x:Name="Clock" Text="08:50" FontFamily="{StaticResource Serif}" FontSize="44" Foreground="{StaticResource Amber}" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Thứ Năm · 24/9 (giờ kịch bản)" Foreground="{StaticResource Soft}" FontSize="12" />
                            <TextBlock x:Name="ClockState" Text="trước giờ làm" Foreground="{StaticResource Soft}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Milo đang làm gì -->
                    <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="12,9" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CapTag" Text="CHỜ" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Amber}" />
                                <TextBlock x:Name="CapRef" Margin="8,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                            <TextBlock x:Name="CapText" Margin="0,4,0,0" Foreground="{StaticResource Cream}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="PlayBtn" Style="{StaticResource Primary}" Content="Tạm dừng" Margin="0,0,6,6" Click="Play_Click" />
                        <Button Style="{StaticResource Round}" Content="Làm lại" Margin="0,0,6,6" Click="Reset_Click" />
                        <Border Background="{StaticResource Panel2}" CornerRadius="999" Padding="3" Margin="0,0,0,6">
                            <StackPanel x:Name="SpeedSeg" Orientation="Horizontal">
                                <Button Style="{StaticResource Round}" Content="60×" Tag="60" MinHeight="26" Padding="10,0" Click="Speed_Click" />
                                <Button Style="{StaticResource Round}" Content="120×" Tag="120" MinHeight="26" Padding="10,0" Click="Speed_Click" />
                                <Button Style="{StaticResource Round}" Content="300×" Tag="300" MinHeight="26" Padding="10,0" Click="Speed_Click" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                               Text="Lúc Milo ẩn, đồng hồ kịch bản tua nhanh. Lúc Milo xuất hiện, thời gian chạy thật để bạn xem trọn hoạt ảnh." />
                    <CheckBox x:Name="AutoChk" IsChecked="True" Margin="0,10,0,0" Foreground="{StaticResource Soft}" FontSize="12" Checked="Auto_Changed" Unchecked="Auto_Changed">
                        <TextBlock TextWrapping="Wrap" Text="Người dùng trong kịch bản tự trả lời. Bỏ chọn để bạn tự bấm các nút trên thẻ của Milo." />
                    </CheckBox>
                    <TextBlock x:Name="LlmLine" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="NGÀY MẪU · BẤM ĐỂ NHẢY TỚI" Margin="0,16,0,8" />
                    <StackPanel x:Name="Miles" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="CHẠY TỪNG CASE · 16 EPISODE" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Milo giao case đó ngay trên desktop (bỏ qua điều kiện và ngân sách). Nếu lúc đó máy khoá hoặc đang họp theo kịch bản, đồng hồ tua tới 13:02 trước." />
                    <StackPanel x:Name="Cases" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="BẠN THỬ LÀM (BẺ KỊCH BẢN)" Margin="0,16,0,8" />
                    <UniformGrid x:Name="Acts" Columns="2">
                        <Button Style="{StaticResource Round}" Tag="typing" Content="Đang gõ phím" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="away" Content="Rời khỏi máy" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="lock" Content="Khoá máy" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="fullscreen" Content="Mở toàn màn hình" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="dnd" Content="Teams: Không làm phiền" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="leave" Content="Rời cuộc họp" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="frag" Content="Nhảy việc 12 lần/giờ" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="done" Content="Kéo 1 task sang Done" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="stress" Content="Giả lập ngày căng (−30)" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="dash" Content="Mở dashboard" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Trên desktop: rê chuột lên chóp đuôi để Milo ló đầu, bấm để mở dashboard, kéo đuôi sang góc khác để đổi góc neo. Đóng cửa sổ này thì Milo vẫn chạy (biểu tượng ở khay hệ thống)." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <c:BrainPanel x:Name="Brain" Grid.Column="1" />
    </Grid>
</Window>
