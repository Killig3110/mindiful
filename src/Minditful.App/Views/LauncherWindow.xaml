<Window x:Class="Minditful.App.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minditful · Chọn môi trường" Width="920" Height="520" ResizeMode="CanMinimize"
        Background="#F7F0E6" Foreground="#3A2A1E" FontFamily="{StaticResource Sans}" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/Brand/milo.ico">
    <Window.Resources>
        <Style x:Key="EnvCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#FFFDF9" CornerRadius="16" Padding="18" BorderThickness="2" BorderBrush="#EADCC7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#E8772E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#E8772E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
    <!-- Dải 3 màu Bosch: đỏ · xanh dương · xanh lá, màu đặc chia đều -->
    <UniformGrid DockPanel.Dock="Top" Rows="1" Height="5">
        <Border Background="#E20015" />
        <Border Background="#007BC0" />
        <Border Background="#00884A" />
    </UniformGrid>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Image Source="pack://application:,,,/Assets/Brand/logo.png" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" DockPanel.Dock="Left" />
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="MINDITFUL · MILO" />
                <TextBlock Text="Hôm nay chạy Milo ở đâu?" FontSize="22" FontWeight="Bold" Foreground="#3A2A1E" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Cả ba đều là Milo thật ở góc màn hình. Chỉ khác nhau chỗ Milo lấy lịch, email, task từ đâu. Lần đầu dùng thì chọn Demo." />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
            <Button Style="{StaticResource EnvCard}" Margin="0,0,8,0" Click="Demo_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="1 · DEMO · NGÀY MẪU" Foreground="#7261B0" />
                    <TextBlock Text="Xem thử, present" FontSize="17" FontWeight="Bold" Foreground="#3A2A1E" Margin="0,6,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="#6B5646" Margin="0,8,0,0"
                               Text="Milo sống qua 1 ngày làm việc mẫu (Thứ Năm 24/9) với lịch, email, task có sẵn. Tua nhanh, nhảy tới từng mốc, cho Milo làm từng tình huống." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Không cần tài khoản, không kết nối mạng" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource EnvCard}" Margin="4,0" Click="Sandbox_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="2 · SANDBOX · TENANT THỬ" Foreground="#2E7D6B" />
                    <TextBlock Text="Thử với dữ liệu thật" FontSize="17" FontWeight="Bold" Foreground="#3A2A1E" Margin="0,6,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="#6B5646" Margin="0,8,0,0"
                               Text="Đăng nhập tenant thử mindiful.onmicrosoft.com: lịch Teams/Outlook, email, Azure Boards thật. Có nút tạo dữ liệu mẫu và chạy thử từng tình huống." />
                    <TextBlock x:Name="SandboxState" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource EnvCard}" Margin="8,0,0,0" Click="Prod_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="3 · PRODUCTION · BOSCH" Foreground="#0F6CBD" />
                    <TextBlock Text="Dùng hằng ngày" FontSize="17" FontWeight="Bold" Foreground="#3A2A1E" Margin="0,6,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="#6B5646" Margin="0,8,0,0"
                               Text="Tài khoản Bosch: Milo đọc lịch, trạng thái Teams, Azure Boards của bạn, tự im lặng khi bạn họp và ẩn khỏi màn hình chia sẻ." />
                    <TextBlock x:Name="ProdState" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <CheckBox x:Name="Remember" Foreground="#6B5646" VerticalAlignment="Center"
                      Content="Nhớ lựa chọn (giữ Shift khi mở app để quay lại màn hình này)" />
            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Cũng có thể chạy: Minditful.exe --env Demo | Sandbox | Production" />
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
