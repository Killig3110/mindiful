<Window x:Class="Minditful.App.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minditful · Chọn môi trường" Width="920" Height="520" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Sans}" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="EnvCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Panel}" CornerRadius="16" Padding="18" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Amber}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Amber}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Eyebrow}" Text="MINDITFUL · MILO" />
            <TextBlock Text="Chạy Milo ở môi trường nào?" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Cream}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Cả ba môi trường dùng chung một bộ não (Rule Engine → Điều phối → Mood Engine). Khác nhau ở nguồn dữ liệu và nơi Milo xuất hiện." />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
            <Button Style="{StaticResource EnvCard}" Margin="0,0,8,0" Click="Demo_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="1 · DEMO" Foreground="{StaticResource Amber}" />
                    <TextBlock Text="App thật · dữ liệu kịch bản" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Cream}" Margin="0,6,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Soft}" Margin="0,8,0,0"
                               Text="Milo sống trên desktop như Sandbox/Production, nhưng giờ, lịch, email, task và thao tác người dùng lấy từ ngày mẫu Thứ Năm 24/9 để chạy đủ mọi case của prototype. Có bảng điều khiển để tua, nhảy mốc, bật từng case." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Không cần tài khoản, không kết nối mạng" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource EnvCard}" Margin="4,0" Click="Sandbox_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="2 · SANDBOX" Foreground="{StaticResource Amber}" />
                    <TextBlock Text="Tài khoản cá nhân" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Cream}" Margin="0,6,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Soft}" Margin="0,8,0,0"
                               Text="Milo sống trên desktop thật, đọc lịch và email từ Microsoft account cá nhân, work item từ Azure DevOps org cá nhân. Có nút tạo dữ liệu mẫu, giả lập tín hiệu và chạy thử từng case." />
                    <TextBlock x:Name="SandboxState" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource EnvCard}" Margin="8,0,0,0" Click="Prod_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="3 · PRODUCTION" Foreground="{StaticResource Amber}" />
                    <TextBlock Text="Bosch · Teams + Azure Boards" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Cream}" Margin="0,6,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Soft}" Margin="0,8,0,0"
                               Text="Tenant công ty: Teams presence làm cổng Đang họp, bật Không làm phiền khi khoá tập trung, lịch Outlook, Azure Boards thật. Ẩn khỏi share màn hình." />
                    <TextBlock x:Name="ProdState" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <CheckBox x:Name="Remember" Foreground="{StaticResource Soft}" VerticalAlignment="Center"
                      Content="Nhớ lựa chọn (giữ Shift khi mở app để quay lại màn hình này)" />
            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Cũng có thể chạy: Minditful.exe --env Demo | Sandbox | Production" />
        </DockPanel>
    </Grid>
</Window>
