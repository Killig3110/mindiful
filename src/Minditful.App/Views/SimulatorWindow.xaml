<Window x:Class="Minditful.App.Views.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Minditful.App.Controls"
        Title="Minditful · Demo — Milo sống qua một ngày" Width="1440" Height="860" MinWidth="1100" MinHeight="640"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Sans}" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ============ điều khiển ============ -->
        <Border Style="{StaticResource PanelBorder}">
            <ScrollViewer Style="{StaticResource ThinScroll}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="MINDITFUL · MÔI TRƯỜNG DEMO (KỊCH BẢN)" />
                    <TextBlock Text="Milo sống qua một ngày" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Cream}" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock x:Name="Clock" Text="08:50" FontFamily="{StaticResource Serif}" FontSize="44" Foreground="{StaticResource Amber}" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DayLabel" Text="Thứ Năm · 24/9" Foreground="{StaticResource Soft}" FontSize="12" />
                            <TextBlock x:Name="ClockState" Text="trước giờ làm" Foreground="{StaticResource Soft}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="PlayBtn" Style="{StaticResource Primary}" Content="Tạm dừng" Margin="0,0,6,6" Click="Play_Click" />
                        <Button x:Name="ResetBtn" Style="{StaticResource Round}" Content="Làm lại" Margin="0,0,6,6" Click="Reset_Click" />
                        <Border Background="{StaticResource Panel2}" CornerRadius="999" Padding="3" Margin="0,0,0,6">
                            <StackPanel x:Name="SpeedSeg" Orientation="Horizontal">
                                <Button Style="{StaticResource Round}" Content="60×" Tag="60" MinHeight="26" Padding="10,0" Background="Transparent" Click="Speed_Click" />
                                <Button Style="{StaticResource Round}" Content="120×" Tag="120" MinHeight="26" Padding="10,0" Click="Speed_Click" />
                                <Button Style="{StaticResource Round}" Content="300×" Tag="300" MinHeight="26" Padding="10,0" Background="Transparent" Click="Speed_Click" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Lúc Milo ẩn, đồng hồ tua nhanh. Lúc Milo xuất hiện, thời gian chạy thật để bạn xem trọn hoạt ảnh." />
                    <CheckBox x:Name="AutoChk" IsChecked="True" Margin="0,10,0,0" Foreground="{StaticResource Soft}" FontSize="12" Checked="Auto_Changed" Unchecked="Auto_Changed">
                        <TextBlock TextWrapping="Wrap" Text="Người dùng trong kịch bản tự trả lời. Bỏ chọn để bạn tự bấm các nút của Milo." />
                    </CheckBox>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="NGÀY MẪU · BẤM ĐỂ NHẢY TỚI" Margin="0,16,0,8" />
                    <StackPanel x:Name="Miles" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="BẠN THỬ LÀM" Margin="0,16,0,8" />
                    <UniformGrid x:Name="Acts" Columns="2">
                        <Button Style="{StaticResource Round}" Tag="typing" Content="Đang gõ phím" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="away" Content="Rời khỏi máy" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="lock" Content="Khoá máy" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="fullscreen" Content="Mở toàn màn hình" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="dnd" Content="Teams: Không làm phiền" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="leave" Content="Rời cuộc họp" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="frag" Content="Nhảy việc 12 lần/giờ" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="done" Content="Kéo 1 task sang Done" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                        <Button Style="{StaticResource Round}" Tag="stress" Content="Giả lập ngày căng (−30 điểm)" Margin="0,0,6,6" HorizontalContentAlignment="Left" Click="Act_Click" />
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Rê chuột lên chóp đuôi ở góc để Milo ló đầu. Bấm vào đuôi để mở dashboard. Kéo đuôi sang góc khác để đổi góc neo." />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="XEM TỪNG CASE · 16 EPISODE" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Bấm để Milo giao case đó ngay (bỏ qua điều kiện và ngân sách). Nếu lúc đó máy khoá hoặc đang họp, ngày mẫu tua tới 13:02 trước. Bỏ chọn &quot;tự trả lời&quot; để tự bấm các nút trên thẻ." />
                    <StackPanel x:Name="Cases" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ sân khấu ============ -->
        <Grid Grid.Column="1" Margin="12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border CornerRadius="14" ClipToBounds="True" VerticalAlignment="Top">
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <c:DesktopScene x:Name="Scene" />
                </Viewbox>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="14,10" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel2}" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="CapTag" Text="CHỜ" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Amber}" />
                    </Border>
                    <TextBlock x:Name="CapText" Grid.Column="1" Margin="10,0" Foreground="{StaticResource Cream}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock x:Name="CapRef" Grid.Column="2" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ bộ não ============ -->
        <c:BrainPanel x:Name="Brain" Grid.Column="2" />
    </Grid>
</Window>
