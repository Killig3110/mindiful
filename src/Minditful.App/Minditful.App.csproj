<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Minditful</AssemblyName>
    <RootNamespace>Minditful.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI khai báo trong manifest là đúng cho WPF; cảnh báo này dành cho WinForms -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Logo: Milo đội mũ Bosch + dải 3 màu Bosch (Assets/Brand/logo.svg) -->
    <ApplicationIcon>Assets\Brand\milo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Chỉ dùng NotifyIcon của WinForms; tránh đụng tên với WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.4" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.66.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Minditful.Core\Minditful.Core.csproj" />
    <ProjectReference Include="..\Minditful.Integrations\Minditful.Integrations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Milo\*.svg" />
    <Resource Include="Assets\Brand\milo.ico" />
    <Resource Include="Assets\Brand\*.png" />
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
