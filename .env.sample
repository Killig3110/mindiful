# ─────────────────────────────────────────────────────────────────────────────
# Minditful · biến môi trường
# Copy file này thành .env rồi điền giá trị. .env KHÔNG được commit (đã có trong .gitignore).
# Dòng để trống giá trị = dùng mặc định trong appsettings.json.
# Biến môi trường thật của máy luôn được ưu tiên hơn .env.
# Cú pháp MINDITFUL__Minditful__A__B tương ứng khoá "Minditful:A:B" trong appsettings.json.
# ─────────────────────────────────────────────────────────────────────────────

# Môi trường mở mặc định: Scenario (Demo) | Sandbox | Prod (để trống = hiện màn hình chọn)
# Thứ tự ưu tiên: --env > MINDITFUL_ENV > giá trị này
MINDITFUL_ENV=

# ── Claude · Lớp 2 lời thoại ─────────────────────────────────────────────────
# Để trống: Milo dùng câu mẫu (mọi tính năng khác vẫn chạy đủ).
ANTHROPIC_API_KEY=
# Tuỳ chọn: đổi model (mặc định claude-opus-5), bật Claude trong Demo
MINDITFUL__Minditful__Llm__Model=
MINDITFUL__Minditful__Llm__UseInDemo=

# ── Sandbox · tenant mindiful.onmicrosoft.com (docs/KET-NOI-SANDBOX.md) ────────
# TenantId/ClientId/org/project/team đã có sẵn trong appsettings.json — chỉ cần PAT.
# PAT do thulu@ tạo, scope Work Items (Read & write) + Project and Team (Read)
MINDITFUL_SANDBOX_ADO_PAT=
# Tuỳ chọn: ghi đè cấu hình sandbox nếu đổi app registration/org
MINDITFUL__Minditful__Sandbox__Graph__ClientId=
MINDITFUL__Minditful__Sandbox__Graph__TenantId=
MINDITFUL__Minditful__Sandbox__AzureDevOps__Organization=

# ── Production · tenant Bosch ────────────────────────────────────────────────
# TenantId/ClientId đã có trong appsettings.json; còn thiếu org/project Azure DevOps của Bosch
MINDITFUL__Minditful__Production__AzureDevOps__Organization=
MINDITFUL__Minditful__Production__AzureDevOps__Project=
MINDITFUL__Minditful__Production__AzureDevOps__Team=
# PAT chỉ cần Work Items (Read) + Project and Team (Read)
MINDITFUL_PROD_ADO_PAT=
