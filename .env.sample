# ─────────────────────────────────────────────────────────────────────────────
# Minditful · biến môi trường
# Copy file này thành .env rồi điền giá trị. .env KHÔNG được commit (đã có trong .gitignore).
# Dòng để trống giá trị = dùng mặc định trong appsettings.json.
# Biến môi trường thật của máy luôn được ưu tiên hơn .env.
# Cú pháp MINDITFUL__Minditful__A__B tương ứng khoá "Minditful:A:B" trong appsettings.json.
# ─────────────────────────────────────────────────────────────────────────────

# Môi trường mở mặc định: Scenario (Demo) | Sandbox | Prod (để trống = hiện màn hình chọn)
# Thứ tự ưu tiên: --env > MINDITFUL_ENV > giá trị này
MINDITFUL_ENV=

# ── Giờ làm (Bosch flexible) ─────────────────────────────────────────────────
# Flexible: giờ bắt đầu = lần mở máy đầu ngày trong 08:00–10:00, giờ về = bắt đầu + 9 tiếng (8→17, 9→18, 10→19)
# Fixed: dùng đúng Start–End
MINDITFUL__Minditful__WorkDay__Mode=
MINDITFUL__Minditful__WorkDay__FlexEarliestStart=
MINDITFUL__Minditful__WorkDay__FlexLatestStart=
MINDITFUL__Minditful__WorkDay__FlexHours=
# Chỉ dùng khi Mode=Fixed (giờ vào – giờ về cố định, dạng HH:mm)
MINDITFUL__Minditful__WorkDay__Start=
MINDITFUL__Minditful__WorkDay__End=
# Idle bao nhiêu phút thì coi là rời máy (tính là 1 lần nghỉ)
MINDITFUL__Minditful__WorkDay__AwayAfterMinutes=

# ── Dữ liệu cá nhân trên máy (SQLite, tự xoá) ─────────────────────────────────
# Week | Month — sang tuần mới (thứ Hai) / tháng mới thì tự xoá dữ liệu cũ
MINDITFUL__Minditful__Storage__RetentionPeriod=
# true = giữ thêm 1 kỳ trước (cho chùm nho 7 ngày, cá nhân hoá, so sánh tuần trước); false = chỉ giữ kỳ hiện tại
MINDITFUL__Minditful__Storage__KeepPreviousPeriod=
# Bao nhiêu phút lưu 1 mẫu mood + bản ghi ngày đang chạy
MINDITFUL__Minditful__Storage__MoodSampleMinutes=
# Kiểm chứng điểm: giữ bao nhiêu tuần cặp số (điểm Milo TB tuần, điểm WHO-5) để tính tương quan
MINDITFUL__Minditful__Storage__ValidationWeeks=

# ── Chăm sóc mở rộng (Sandbox/Production; Demo bật thử từ bảng điều khiển) ─────
# FocusPlan: đề nghị giữ khoảng trống dài nhất trong ngày làm giờ tập trung, tới giờ tự bật Không làm phiền
MINDITFUL__Minditful__Wellbeing__FocusPlan=
# Khoảng trống tối thiểu (phút) mới đề nghị giữ giờ tập trung
MINDITFUL__Minditful__Wellbeing__FocusPlanMinMinutes=
# WeekReport: sáng thứ Hai tóm tắt tuần trước + 1 mẹo
MINDITFUL__Minditful__Wellbeing__WeekReport=
# MicroBreakEveryMinutes: nhắc uống nước / 20-20-20 sau mỗi N phút ngồi máy liên tục (0 = tắt)
MINDITFUL__Minditful__Wellbeing__MicroBreakEveryMinutes=
# Tối đa bao nhiêu lần nhắc uống nước / nhìn xa mỗi ngày
MINDITFUL__Minditful__Wellbeing__MicroBreakMaxPerDay=
# EveningCheck: thẻ tan tầm hỏi "Hôm nay thấy sao?" + gợi ý nghỉ giữa chuỗi họp ngày mai
MINDITFUL__Minditful__Wellbeing__EveningCheck=
# HideWhenPresenting: Teams báo đang trình chiếu → Milo trốn hẳn, kể cả chóp đuôi
MINDITFUL__Minditful__Wellbeing__HideWhenPresenting=
# Wardrobe: tủ đồ phối đồ, mở khoá khi về đúng giờ, nghỉ cùng Milo, tập trung sâu, và theo mùa
MINDITFUL__Minditful__Wellbeing__Wardrobe=
# Incoming: thẻ "Có mới" — báo email mới gửi thẳng cho bạn, lời mời họp mới, task mới được giao (true/false)
MINDITFUL__Minditful__Wellbeing__Incoming=
# Personality: tính cách Milo — Mixed (Pha trộn: phần lớn dễ thương, lâu lâu hài; mặc định), Cute (Dễ thương), Funny (Hài hước).
#   Người dùng đổi bằng chuột phải Milo / bảng điều khiển thì lựa chọn đó được nhớ, đè lên giá trị này.
MINDITFUL__Minditful__Wellbeing__Personality=

# ── Claude · Lớp 2 lời thoại ─────────────────────────────────────────────────
# Để trống: Milo dùng câu mẫu (mọi tính năng khác vẫn chạy đủ).
ANTHROPIC_API_KEY=
# Công tắc tổng (true/false). Tắt thì mọi thứ chạy bằng luật + câu mẫu.
MINDITFUL__Minditful__Llm__Enabled=
# Nhà cung cấp AI: Claude (mặc định, dùng ANTHROPIC_API_KEY) hoặc OpenAI = mọi dịch vụ tương thích OpenAI (dùng LLM_API_KEY).
#   Ollama trên máy (miễn phí, không giới hạn):  Provider=OpenAI · BaseUrl=http://localhost:11434/v1 · Model=qwen2.5:7b · không cần key
#   Groq:    Provider=OpenAI · BaseUrl=https://api.groq.com/openai/v1 · Model=qwen/qwen3.8-27b (ổn định nhất khi chấm điểm)
#   Gemini:  Provider=OpenAI · BaseUrl=https://generativelanguage.googleapis.com/v1beta/openai/ · Model=gemini-2.5-flash-lite
# Chi tiết và giới hạn gói miễn phí: README mục "Chọn AI để test".
MINDITFUL__Minditful__Llm__Provider=
MINDITFUL__Minditful__Llm__BaseUrl=
# Nhiều key: ngăn bằng dấu phẩy, vd. gsk_aaa,gsk_bbb,gsk_ccc — key nào hết lượt (429) tự chuyển sang key kế tiếp.
LLM_API_KEY=
# Tuỳ chọn: đổi model (mặc định claude-opus-5), bật Claude trong Demo
MINDITFUL__Minditful__Llm__Model=
MINDITFUL__Minditful__Llm__UseInDemo=
# Từng tính năng (để trống = mặc định trong appsettings.json):
#   Lines/Chat: true|false — Claude viết câu thoại / trả lời chat tự do
#   Mood: Rules | Hybrid | Llm — Rules = Mood Engine theo luật; Hybrid = luật + Claude chỉnh ±10 điểm; Llm = Claude chấm điểm
#   Meetings: Rules | Llm — đánh giá mức nặng từng cuộc họp (chỉ gửi số liệu, không gửi tiêu đề)
#   IncludeChatInMood: true|false — gửi kèm câu bạn tự gõ cho Milo để Claude đọc cảm xúc
MINDITFUL__Minditful__Llm__Features__Lines=
MINDITFUL__Minditful__Llm__Features__Chat=
MINDITFUL__Minditful__Llm__Features__Mood=
MINDITFUL__Minditful__Llm__Features__Meetings=
MINDITFUL__Minditful__Llm__Features__MoodIntervalMinutes=
MINDITFUL__Minditful__Llm__Features__IncludeChatInMood=

# ── Sandbox · tenant mindiful.onmicrosoft.com (docs/KET-NOI-SANDBOX.md) ────────
# TenantId/ClientId/org/project/team đã có sẵn trong appsettings.json — chỉ cần PAT.
# PAT do thulu@ tạo, scope Work Items (Read & write) + Project and Team (Read)
MINDITFUL_SANDBOX_ADO_PAT=
# Chế độ Sandbox: true = test (công cụ ép Milo làm như Demo + ngưỡng rút ngắn), false = chạy như Production.
# Đổi được ngay trong bảng điều khiển / menu khay; lựa chọn đó được nhớ trên máy và thắng giá trị này.
MINDITFUL__Minditful__Sandbox__TestMode=
# Tuỳ chọn: ghi đè cấu hình sandbox nếu đổi app registration/org
MINDITFUL__Minditful__Sandbox__Graph__ClientId=
MINDITFUL__Minditful__Sandbox__Graph__TenantId=
MINDITFUL__Minditful__Sandbox__AzureDevOps__Organization=

# ── Production · tenant Bosch ────────────────────────────────────────────────
# TenantId/ClientId đã có trong appsettings.json; còn thiếu org/project Azure DevOps của Bosch
MINDITFUL__Minditful__Production__AzureDevOps__Organization=
MINDITFUL__Minditful__Production__AzureDevOps__Project=
MINDITFUL__Minditful__Production__AzureDevOps__Team=
# PAT chỉ cần Work Items (Read) + Project and Team (Read)
MINDITFUL_PROD_ADO_PAT=
